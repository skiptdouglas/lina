<section class="section">
  <div class="page-width" style="max-width:460px">
    <h1>{{ 'account.create' | t }}</h1>
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div style="display:grid;gap:12px">
        <label for="RegFirst">{{ 'account.first_name' | t }}</label>
        <input class="input" id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name">
        <label for="RegEmail">{{ 'account.email' | t }}</label>
        <input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required>
        <label for="RegPassword">{{ 'account.password' | t }}</label>
        <input class="input" id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        <label><input type="checkbox" name="customer[accepts_marketing]" checked> {{ 'account.drop_alerts_opt_in' | t }}</label>
        <button class="button button--full">{{ 'account.create' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</section>
