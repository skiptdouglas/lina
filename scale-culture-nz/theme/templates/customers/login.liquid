<section class="section">
  <div class="page-width" style="max-width:460px">
    <h1>{{ 'account.login' | t }}</h1>
    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}
      <div style="display:grid;gap:12px">
        <label for="LoginEmail">{{ 'account.email' | t }}</label>
        <input class="input" id="LoginEmail" type="email" name="customer[email]" autocomplete="email" required>
        <label for="LoginPassword">{{ 'account.password' | t }}</label>
        <input class="input" id="LoginPassword" type="password" name="customer[password]" autocomplete="current-password" required>
        <button class="button button--full">{{ 'account.login' | t }}</button>
        <a href="{{ routes.account_register_url }}" style="text-decoration:underline">{{ 'account.create' | t }}</a>
      </div>
    {%- endform -%}
  </div>
</section>
