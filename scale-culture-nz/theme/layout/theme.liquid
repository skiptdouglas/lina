<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0b0b0c">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      :root {
        --color-accent: {{ settings.color_accent }};
        --low-stock-threshold: {{ settings.low_stock_threshold }};
      }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'mobile-nav' %}

    <div class="drawer" id="CartDrawer" data-cart-drawer hidden>
      <div class="drawer__overlay" data-drawer-close></div>
      <div data-cart-drawer-content>{% section 'cart-drawer' %}</div>
    </div>

    <script>
      window.ScaleCulture = {
        collector: {
          enabled: {{ settings.collector_enabled | json }},
          proxy: {{ settings.collector_proxy | default: '/apps/collector' | json }},
          loggedIn: {% if customer %}true{% else %}false{% endif %},
          {%- assign server_wishlist = customer.metafields.scale.wishlist.value %}
          wishlist: {% if customer and settings.collector_enabled %}{% if server_wishlist %}{{ server_wishlist | json }}{% else %}[]{% endif %}{% else %}null{% endif %}
        },
        klaviyo: {{ settings.klaviyo_public_key | json }},
        cartDrawer: {{ settings.cart_drawer | json }},
        routes: {
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_url: {{ routes.cart_url | json }},
          search_url: {{ routes.search_url | json }}
        },
        strings: {
          added: {{ 'products.added_to_cart' | t | json }},
          wishlistAdded: {{ 'wishlist.added' | t | json }},
          wishlistRemoved: {{ 'wishlist.removed' | t | json }}
        }
      };
    </script>
  </body>
</html>
