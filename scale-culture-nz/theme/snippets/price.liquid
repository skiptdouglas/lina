{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
-%}
{%- if v.compare_at_price > v.price -%}
  <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>{{ v.price | money }}
  <s><span class="visually-hidden">{{ 'products.regular_price' | t }}</span>{{ v.compare_at_price | money }}</s>
{%- else -%}
  {%- if product.price_varies and variant == blank %}{{ 'products.from' | t }} {% endif -%}
  {{ v.price | money }}
{%- endif -%}
