{%- comment -%} Structured specifications from metafields (SOP §12) {%- endcomment -%}
{%- assign m = product.metafields.scale -%}
<table class="spec-table">
  <tbody>
    <tr><th>{{ 'specs.sku' | t }}</th><td>{{ variant.sku }}</td></tr>
    <tr><th>{{ 'specs.brand' | t }}</th><td><a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></td></tr>
    {%- if product.type != blank -%}<tr><th>{{ 'specs.type' | t }}</th><td>{{ product.type }}</td></tr>{%- endif -%}
    {%- if m.scale != blank -%}<tr><th>{{ 'specs.scale' | t }}</th><td>{{ m.scale.value }}</td></tr>{%- endif -%}
    {%- if m.vehicle_make != blank -%}<tr><th>{{ 'specs.make' | t }}</th><td>{{ m.vehicle_make.value }}</td></tr>{%- endif -%}
    {%- if m.vehicle_model != blank -%}<tr><th>{{ 'specs.model' | t }}</th><td>{{ m.vehicle_model.value }}</td></tr>{%- endif -%}
    {%- if m.vehicle_generation != blank -%}<tr><th>{{ 'specs.generation' | t }}</th><td>{{ m.vehicle_generation.value }}</td></tr>{%- endif -%}
    {%- if m.colour != blank -%}<tr><th>{{ 'specs.colour' | t }}</th><td>{{ m.colour.value }}</td></tr>{%- endif -%}
    {%- if m.vehicle_year != blank -%}<tr><th>{{ 'specs.year' | t }}</th><td>{{ m.vehicle_year.value }}</td></tr>{%- endif -%}
    {%- if m.series != blank -%}<tr><th>{{ 'specs.series' | t }}</th><td>{{ m.series.value }}</td></tr>{%- endif -%}
    {%- if m.motorsport_category != blank -%}<tr><th>{{ 'specs.motorsport' | t }}</th><td>{{ m.motorsport_category.value }}</td></tr>{%- endif -%}
    {%- if m.street_race != blank -%}<tr><th>{{ 'specs.street_race' | t }}</th><td>{{ m.street_race.value }}</td></tr>{%- endif -%}
    {%- if m.release_date != blank -%}<tr><th>{{ 'specs.release_date' | t }}</th><td>{{ m.release_date.value | date: '%B %Y' }}</td></tr>{%- endif -%}
    {%- if m.country_of_origin != blank -%}<tr><th>{{ 'specs.country' | t }}</th><td>{{ m.country_of_origin.value }}</td></tr>{%- endif -%}
    {%- if m.limited_edition.value -%}<tr><th>{{ 'specs.limited' | t }}</th><td>{{ m.limited_edition_note.value | default: 'Yes' }}</td></tr>{%- endif -%}
    {%- if m.mpn != blank -%}<tr><th>{{ 'specs.mpn' | t }}</th><td>{{ m.mpn.value }}</td></tr>{%- endif -%}
    {%- if variant.barcode != blank -%}<tr><th>{{ 'specs.barcode' | t }}</th><td>{{ variant.barcode }}</td></tr>{%- endif -%}
    {%- if m.package_dimensions != blank -%}<tr><th>{{ 'specs.package' | t }}</th><td>{{ m.package_dimensions.value }}</td></tr>{%- endif -%}
    {%- if variant.weight > 0 -%}<tr><th>{{ 'specs.weight' | t }}</th><td>{{ variant.weight | weight_with_unit }}</td></tr>{%- endif -%}
  </tbody>
</table>
