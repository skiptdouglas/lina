{%- comment -%}
  My Garage controls on the product page (SOP §19): Owned / Wanted / Pre-ordered.
  State is read from the customer's garage metafield; changes go to the collector service.
{%- endcomment -%}
{%- if settings.collector_enabled -%}
  {%- liquid
    assign pid = product.id | append: ''
    assign current = ''
    if customer
      assign entry = customer.metafields.scale.garage.value | where: 'pid', pid | first
      assign current = entry.status
    endif
    assign statuses = 'owned,wanted,preordered' | split: ','
  -%}
  <div class="garage-control" data-garage-control data-product-id="{{ product.id }}">
    <span class="eyebrow">{{ 'garage.add_to' | t }}</span>
    {%- if customer -%}
      <div class="segmented" role="group" aria-label="{{ 'garage.title' | t }}">
        {%- for s in statuses -%}
          <button type="button" data-garage-status="{{ s }}" aria-pressed="{% if current == s %}true{% else %}false{% endif %}">
            {%- case s -%}
              {%- when 'owned' -%}{{ 'garage.owned' | t }}
              {%- when 'wanted' -%}{{ 'garage.wanted' | t }}
              {%- when 'preordered' -%}{{ 'garage.preordered' | t }}
            {%- endcase -%}
          </button>
        {%- endfor -%}
      </div>
      <a href="/pages/garage" class="garage-control__link" data-garage-link{% if current == blank %} hidden{% endif %}>{{ 'garage.view' | t }} →</a>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="garage-control__link">{{ 'garage.login_to_add' | t }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
