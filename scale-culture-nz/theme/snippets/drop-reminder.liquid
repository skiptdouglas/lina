{%- comment -%}
  Advanced drop alert (SOP §37): "Remind me" for one specific drop. Sends a
  Klaviyo "Drop Reminder Requested" event carrying the drop details so a flow /
  segment can email exactly these collectors when it lands.
{%- endcomment -%}
{%- if settings.klaviyo_public_key != blank -%}
  <form class="restock-form" data-drop-reminder
    data-drop-name="{{ drop.name.value | escape }}"
    data-drop-handle="{{ drop.system.handle }}"
    data-drop-date="{{ drop.release_date.value | date: '%Y-%m-%dT%H:%M:%S%z' }}"
    data-drop-brands="{{ drop.brands.value | join: ', ' | escape }}"
    data-drop-url="{{ shop.url }}{{ drop.system.url }}">
    <p class="restock-form__title">{{ 'drops.remind_title' | t }}</p>
    <div class="field-row">
      <label for="DropReminder" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
      <input id="DropReminder" type="email" name="email" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}" value="{{ customer.email }}">
      <button type="submit" class="button button--accent">{{ 'drops.remind' | t }}</button>
    </div>
    <p class="restock-form__status" role="status" data-restock-status></p>
  </form>
{%- endif -%}
