{%- comment -%}
  Stock status label. Params: product, variant (optional), state (optional, pre-resolved)
{%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  if state == blank
    capture state
      render 'stock-state', product: product, variant: v
    endcapture
    assign state = state | strip
  endif
-%}
<span class="stock stock--{{ state }}" data-stock-state="{{ state }}">
  {%- if state == 'low_stock' -%}
    {{ 'products.stock.low_stock_count' | t: count: v.inventory_quantity }}
  {%- else -%}
    {% render 'stock-label', state: state %}
  {%- endif -%}
</span>
