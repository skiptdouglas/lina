{%- assign has_active = false -%}
{%- for filter in results.filters -%}{%- if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value -%}{%- assign has_active = true -%}{%- endif -%}{%- endfor -%}
{%- if has_active -%}
  <div class="active-facets">
    {%- for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <a href="{{ value.url_to_remove }}">{{ value.label }} <span aria-hidden="true">×</span><span class="visually-hidden">{{ 'filters.remove' | t }}</span></a>
      {%- endfor -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value or filter.max_value.value -%}
          <a href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">×</span></a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    <a href="{{ url }}" style="background:none;text-decoration:underline">{{ 'filters.clear' | t }}</a>
  </div>
{%- endif -%}
