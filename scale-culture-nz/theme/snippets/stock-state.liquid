{%- comment -%}
  Resolves the single stock state for a product/variant (SOP §15).
  Outputs one key: in_stock | low_stock | preorder | coming_soon | incoming | sold_out | discontinued
  Usage: {%- capture state -%}{% render 'stock-state', product: product, variant: variant %}{%- endcapture -%}

  The `scale.availability` metafield is the owner's manual override for the
  inventory workflow (SOP §29); when blank, state is derived from inventory.
{%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign override = product.metafields.scale.availability.value | default: 'auto'
  assign threshold = settings.low_stock_threshold | default: 3

  case override
    when 'discontinued'
      echo 'discontinued'
    when 'coming_soon', 'incoming'
      echo override
    when 'preorder'
      if v.available
        echo 'preorder'
      else
        echo 'sold_out'
      endif
    else
      if v.available == false
        echo 'sold_out'
      elsif v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity <= threshold
        echo 'low_stock'
      else
        echo 'in_stock'
      endif
  endcase
-%}
