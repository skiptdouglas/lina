{%- comment -%}
  Product card (SOP §5): image, brand, vehicle/model name, scale, price, stock status.
  Params: product, lazy (bool, default true)
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.scale
  capture state
    render 'stock-state', product: product
  endcapture
  assign state = state | strip
  assign card_title = m.card_title.value | default: product.title
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
  assign image_alt = product.featured_media.alt | default: product.title
  assign is_new = false
  assign days_new = settings.new_badge_days | default: 21 | times: 86400
  assign published = product.published_at | date: '%s' | plus: 0
  assign now = 'now' | date: '%s' | plus: 0
  assign age = now | minus: published
  if age < days_new
    assign is_new = true
  endif
-%}
<article class="card">
  <div class="card__media">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 900
        | image_tag:
          loading: loading,
          widths: '300, 450, 600, 900',
          sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
          alt: image_alt
      }}
      {%- if product.media[1] -%}
        {{ product.media[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw', alt: '' }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    <div class="card__badges">
      {%- case state -%}
        {%- when 'preorder' -%}<span class="badge badge--accent">{{ 'products.stock.preorder' | t }}</span>
        {%- when 'sold_out' -%}<span class="badge">{{ 'products.stock.sold_out' | t }}</span>
        {%- when 'coming_soon', 'incoming' -%}<span class="badge badge--light">{{ 'products.stock.coming_soon' | t }}</span>
      {%- endcase -%}
      {%- if m.limited_edition.value -%}<span class="badge">{{ 'products.limited' | t }}</span>{%- endif -%}
      {%- if is_new and state != 'sold_out' -%}<span class="badge badge--light">{{ 'products.new' | t }}</span>{%- endif -%}
    </div>
  </div>
  <div class="card__wishlist">{% render 'wishlist-button', product: product %}</div>
  <div class="card__info">
    <span class="card__brand">{{ product.vendor }}</span>
    <h3 class="card__title"><a href="{{ product.url }}">{{ card_title }}</a></h3>
    <div class="card__meta">
      <span class="card__scale">{{ m.scale.value }}</span>
      <span class="card__price">{% render 'price', product: product %}</span>
    </div>
    <div class="card__stock">{% render 'stock-status', product: product, state: state %}</div>
    {% render 'rating', product: product %}
    {%- capture lim -%}{% render 'limit-state', product: product %}{%- endcapture -%}
    {%- assign lim_parts = lim | strip | split: '|' -%}
    {%- assign lim_max = lim_parts[0] | plus: 0 -%}
    {%- if lim_max > 0 -%}<span class="card__limit">{{ 'limits.max_per_customer' | t: count: lim_max }}</span>{%- endif -%}
    {%- if settings.quick_add and product.has_only_default_variant and lim_parts[2] != 'true' and lim_parts[1] != '0' -%}
      {%- if state == 'in_stock' or state == 'low_stock' or state == 'preorder' -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="quick-add" data-ajax-cart>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          {%- if lim_max > 0 -%}<input type="hidden" data-limit-product="{{ product.id }}" data-limit-remaining="{{ lim_parts[1] }}" data-limit-max="{{ lim_max }}" data-limit-title="{{ product.title | escape }}">{%- endif -%}
          {%- if state == 'preorder' -%}
            <input type="hidden" name="properties[_preorder]" value="true">
            {%- if m.preorder_nz_arrival != blank -%}<input type="hidden" name="properties[Expected NZ arrival]" value="{{ m.preorder_nz_arrival.value | escape }}">{%- endif -%}
          {%- endif -%}
          <button type="submit" class="quick-add__button{% if state == 'preorder' %} quick-add__button--pre{% endif %}">
            {%- if state == 'preorder' -%}{{ 'products.reserve' | t }}{%- else -%}{{ 'products.quick_add' | t }}{%- endif -%}
          </button>
        </form>
      {%- endif -%}
    {%- endif -%}
  </div>
</article>
