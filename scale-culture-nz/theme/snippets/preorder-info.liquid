{%- comment -%}
  Pre-order details (SOP §17). Params: product, variant
{%- endcomment -%}
{%- assign m = product.metafields.scale -%}
<div class="preorder-box">
  <span class="badge badge--accent" style="justify-self:start">{{ 'products.stock.preorder' | t }}</span>
  <dl>
    {%- if m.preorder_jp_release != blank -%}
      <dt>{{ 'preorder.jp_release' | t }}</dt><dd>{{ m.preorder_jp_release.value }}</dd>
    {%- endif -%}
    {%- if m.preorder_nz_arrival != blank -%}
      <dt>{{ 'preorder.nz_arrival' | t }}</dt><dd>{{ m.preorder_nz_arrival.value }}</dd>
    {%- endif -%}
    <dt>{{ 'preorder.price' | t }}</dt><dd>{{ variant.price | money }}</dd>
    {%- if m.preorder_deposit != blank -%}
      <dt>{{ 'preorder.deposit' | t }}</dt><dd>{{ m.preorder_deposit.value }}</dd>
    {%- endif -%}
    {%- if m.preorder_allocation != blank -%}
      <dt>{{ 'preorder.allocation' | t }}</dt>
      <dd>
        {%- if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 -%}
          {{ 'preorder.allocation_left' | t: count: variant.inventory_quantity, total: m.preorder_allocation.value }}
        {%- else -%}
          {{ m.preorder_allocation.value }}
        {%- endif -%}
      </dd>
    {%- endif -%}
  </dl>
  <p>{{ settings.preorder_disclaimer }}</p>
</div>
