{%- comment -%} Journal article card. Params: article, lazy {%- endcomment -%}
<article class="article-card">
  <a href="{{ article.url }}" class="article-card__media">
    {%- if article.image -%}
      {%- assign img_alt = article.image.alt | default: article.title -%}
      {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw', alt: img_alt }}
    {%- endif -%}
  </a>
  <div class="article-card__info">
    {%- if article.tags.size > 0 -%}<span class="eyebrow">{{ article.tags.first }}</span>{%- endif -%}
    <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
    <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
    <span class="article-card__meta">{{ article.published_at | date: '%-d %B %Y' }}</span>
  </div>
</article>
