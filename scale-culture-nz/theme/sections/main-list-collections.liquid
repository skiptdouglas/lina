<section class="section">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
    <div class="collection-rail" style="grid-auto-flow:row;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));overflow:visible">
      {%- for c in collections -%}
        {%- if c.handle == 'frontpage' or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
        <a href="{{ c.url }}" class="collection-tile">
          {%- if c.image -%}{{ c.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          <span>{{ c.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }] }
{% endschema %}
