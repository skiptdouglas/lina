{%- comment -%}
  Collection recommendations (SOP §37). For logged-in collectors:
  1. "Complete your <group> collection" — same make/model/generation as their
     biggest garage collection, not already in the garage.
  2. "Recommended for you" — available models from their top garage makes and
     stated interests, excluding anything already in the garage.
  Falls back to a chosen collection for guests.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign picked = ','
  assign rec_html = ''
  assign rec_n = 0
  assign complete_html = ''
  assign complete_n = 0
  assign complete_group = ''

  if customer
    assign garage = customer.metafields.scale.garage.value
    assign stats = customer.metafields.scale.garage_stats.value
    assign profile = customer.metafields.scale.profile.value
    assign exclude = ','
    for e in garage
      assign exclude = exclude | append: e.pid | append: ','
    endfor

    if stats.collections.size > 0
      assign complete_group = stats.collections.first.group
      assign sample = garage | where: 'group', complete_group | first
      assign coll_handle = sample.make | handleize | append: '-models'
      for p in collections[coll_handle].products limit: 100
        if complete_n >= limit
          break
        endif
        assign key = ',' | append: p.id | append: ','
        if exclude contains key or p.available == false
          continue
        endif
        if p.metafields.scale.vehicle_model.value == sample.model and p.metafields.scale.vehicle_generation.value == sample.gen
          capture card
            echo '<li>'
            render 'product-card', product: p
            echo '</li>'
          endcapture
          assign complete_html = complete_html | append: card
          assign complete_n = complete_n | plus: 1
          assign picked = picked | append: p.id | append: ','
        endif
      endfor
    endif

    assign make_list = stats.top_make_handles | join: ','
    for m in profile.interests.makes
      assign mh = m | handleize
      assign make_list = make_list | append: ',' | append: mh
    endfor
    assign make_handles = make_list | split: ',' | uniq
    for mh in make_handles limit: 4
      if mh == blank
        continue
      endif
      assign coll_handle = mh | append: '-models'
      for p in collections[coll_handle].products limit: 24
        if rec_n >= limit
          break
        endif
        assign key = ',' | append: p.id | append: ','
        if exclude contains key or picked contains key or p.available == false
          continue
        endif
        capture card
          echo '<li>'
          render 'product-card', product: p
          echo '</li>'
        endcapture
        assign rec_html = rec_html | append: card
        assign rec_n = rec_n | plus: 1
        assign picked = picked | append: p.id | append: ','
      endfor
    endfor
  endif
-%}

{%- if complete_n > 0 -%}
  <section class="section" style="padding-bottom:0">
    <div class="page-width">
      <div class="section-header">
        <div><p class="eyebrow">{{ 'recommend.from_garage' | t }}</p><h2>{{ 'recommend.complete' | t: group: complete_group }}</h2></div>
        <a href="/pages/garage">{{ 'garage.view' | t }}</a>
      </div>
      <ul class="product-grid product-grid--4">{{ complete_html }}</ul>
    </div>
  </section>
{%- endif -%}

{%- if rec_n > 0 -%}
  <section class="section">
    <div class="page-width">
      <div class="section-header"><div><p class="eyebrow">{{ 'recommend.eyebrow' | t }}</p><h2>{{ section.settings.heading }}</h2></div></div>
      <ul class="product-grid product-grid--4">{{ rec_html }}</ul>
    </div>
  </section>
{%- elsif complete_n == 0 and section.settings.fallback != blank -%}
  <section class="section">
    <div class="page-width">
      <div class="section-header"><h2>{{ section.settings.fallback_heading }}</h2><a href="{{ section.settings.fallback.url }}">{{ 'general.view_all' | t }}</a></div>
      <ul class="product-grid product-grid--4">
        {%- for p in section.settings.fallback.products limit: limit -%}<li>{% render 'product-card', product: p %}</li>{%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Recommended for you",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recommended for you" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 8, "step": 4, "default": 4 },
    { "type": "collection", "id": "fallback", "label": "Guest fallback collection" },
    { "type": "text", "id": "fallback_heading", "label": "Guest heading", "default": "Collector favourites" }
  ],
  "presets": [{ "name": "Recommended for you" }]
}
{% endschema %}
