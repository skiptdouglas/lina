{%- comment -%}
  Cart (SOP §24, §26). In-stock and pre-order lines are grouped separately and
  the customer is told when the cart contains both.
{%- endcomment -%}
{%- liquid
  assign preorder_count = 0
  assign stock_count = 0
  for item in cart.items
    if item.properties['_preorder'] == 'true'
      assign preorder_count = preorder_count | plus: 1
    else
      assign stock_count = stock_count | plus: 1
    endif
  endfor
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  if threshold > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
<div class="page-width">
  <h1 style="margin-top:32px">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <h2>{{ 'cart.empty' | t }}</h2>
      <a href="/collections/new-arrivals" class="button button--accent">{{ 'cart.continue' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm" class="cart-layout">
      <div>
        {%- if preorder_count > 0 and stock_count > 0 -%}
          <div class="cart-notice" role="note">{{ settings.mixed_cart_notice }}</div>
        {%- endif -%}

        {%- assign groups = 'stock,preorder' | split: ',' -%}
        {%- for group in groups -%}
          {%- if group == 'stock' and stock_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- if group == 'preorder' and preorder_count == 0 -%}{%- continue -%}{%- endif -%}
          <div class="cart-group">
            <h2>
              {%- if group == 'preorder' -%}<span class="badge badge--accent">{{ 'products.stock.preorder' | t }}</span>{{ 'cart.preorder_items' | t }}
              {%- else -%}<span class="badge">{{ 'products.stock.in_stock' | t }}</span>{{ 'cart.stock_items' | t }}{%- endif -%}
            </h2>
            {%- for item in cart.items -%}
              {%- liquid
                assign is_pre = false
                if item.properties['_preorder'] == 'true'
                  assign is_pre = true
                endif
                if group == 'preorder' and is_pre == false
                  continue
                endif
                if group == 'stock' and is_pre
                  continue
                endif
              -%}
              <div class="cart-item">
                <a href="{{ item.url }}">
                  {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{%- endif -%}
                </a>
                <div>
                  <div class="card__brand">{{ item.vendor }}</div>
                  <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                  <div class="cart-item__meta">
                    {{ item.product.metafields.scale.scale.value }}
                    {%- unless item.product.has_only_default_variant %} · {{ item.variant.title }}{% endunless -%}
                    {%- for p in item.properties -%}
                      {%- assign first_char = p.first | slice: 0 -%}
                      {%- if p.last != blank and first_char != '_' %}<br>{{ p.first }}: {{ p.last }}{% endif -%}
                    {%- endfor -%}
                  </div>
                  <div class="qty">
                    <button type="button" data-cart-qty="{{ item.key }}" data-delta="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.quantity' | t }}">
                    <button type="button" data-cart-qty="{{ item.key }}" data-delta="1" aria-label="{{ 'products.increase' | t }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" style="font-size:.75rem;text-decoration:underline">{{ 'cart.remove' | t }}</a>
                </div>
                <div style="font-weight:700">{{ item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>

      <aside class="cart-summary">
        <div class="cart-summary__row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.items_subtotal_price | money }}</span></div>
        {%- for discount in cart.cart_level_discount_applications -%}
          <div class="cart-summary__row"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
        {%- endfor -%}
        <div class="cart-summary__row">
          <span>{{ 'cart.shipping' | t }}</span>
          <span>
            {%- if threshold > 0 and remaining <= 0 -%}{{ 'cart.free' | t }}
            {%- else -%}{{ 'cart.shipping_from' | t: price: settings.flat_shipping_rate }}{%- endif -%}
          </span>
        </div>
        {%- if threshold > 0 -%}
          <div class="shipping-bar" aria-hidden="true"><span style="width:{{ pct }}%"></span></div>
          <small>
            {%- if remaining > 0 -%}{%- assign remaining_money = remaining | money -%}{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
            {%- else -%}{{ 'cart.free_shipping_unlocked' | t }}{%- endif -%}
          </small>
        {%- endif -%}
        {%- if preorder_count > 0 -%}<small>{{ settings.preorder_shipping_note }}</small>{%- endif -%}
        <hr style="border:0;border-top:1px solid #d6d7d9;width:100%">
        <div class="cart-summary__row cart-summary__total"><span>{{ 'cart.total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <small>{{ 'cart.taxes' | t }}</small>
        <button type="submit" name="checkout" class="button button--accent button--full">{{ 'cart.checkout' | t }}</button>
        {%- if additional_checkout_buttons -%}<div>{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        <noscript><button type="submit" name="update" class="button button--outline button--full">{{ 'cart.update' | t }}</button></noscript>
      </aside>
    </form>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
