<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <div class="site-header__logo" style="justify-self:start;color:#fff">Scale Culture<span>.</span></div>
        <p>{{ settings.tagline }}</p>
        {%- if section.settings.instagram != blank or section.settings.facebook != blank or section.settings.tiktok != blank -%}
          <ul style="grid-auto-flow:column;justify-content:start;gap:16px">
            {%- if section.settings.instagram != blank -%}<li><a href="{{ section.settings.instagram }}" rel="noopener">Instagram</a></li>{%- endif -%}
            {%- if section.settings.facebook != blank -%}<li><a href="{{ section.settings.facebook }}" rel="noopener">Facebook</a></li>{%- endif -%}
            {%- if section.settings.tiktok != blank -%}<li><a href="{{ section.settings.tiktok }}" rel="noopener">TikTok</a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
    <div class="site-footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · Auckland, New Zealand</span>
      <span>{{ 'footer.payments' | t }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
