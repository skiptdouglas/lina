{%- comment -%} Editorial collections: JDM Legends, 90s Japan, Group A, Super GT... (SOP §11) {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-header">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
      <a href="{{ routes.collections_url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <div class="collection-rail">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{{ c.url | default: '#' }}" class="collection-tile" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: c.image -%}
          {%- if img != blank -%}{{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 25vw, 72vw', alt: '' }}{%- endif -%}
          <span>{{ block.settings.title | default: c.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Automotive culture" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial collections",
      "blocks": [
        { "type": "collection", "settings": { "title": "JDM Legends" } },
        { "type": "collection", "settings": { "title": "90s Japan" } },
        { "type": "collection", "settings": { "title": "Super GT" } },
        { "type": "collection", "settings": { "title": "Liberty Walk" } }
      ]
    }
  ]
}
{% endschema %}
