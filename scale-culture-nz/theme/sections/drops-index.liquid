{%- comment -%} Drops archive — upcoming then historic (SOP §16) {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <h1>{{ section.settings.heading }}</h1>
    {%- assign drops = shop.metaobjects.drop.values | sort: 'number' | reverse -%}
    {%- if drops.size > 0 -%}
      <div class="drop-list">
        {%- for drop in drops -%}
          {%- assign coll = drop.collection.value -%}
          <a class="drop-row" href="{{ drop.system.url }}">
            {%- if drop.image != blank -%}{{ drop.image.value | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}<span></span>{%- endif -%}
            <div>
              <h3>{{ drop.name.value }}</h3>
              <div class="eyebrow">{{ drop.brands.value | join: ' / ' }}</div>
              <div style="font-size:.875rem">{{ drop.release_date.value | date: '%-d %B %Y' }}{% if coll != blank %} · {{ 'drops.product_count' | t: count: coll.products_count }}{% endif %}</div>
            </div>
            <span class="button button--outline" style="min-height:40px;padding:0 16px">{{ 'drops.view' | t }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'drops.none' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Drops archive",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Drops" }],
  "presets": [{ "name": "Drops archive" }]
}
{% endschema %}
