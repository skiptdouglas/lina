{%- comment -%} Featured drop with countdown (SOP §16). Uses the `drop` metaobject. {%- endcomment -%}
{%- assign drop = section.settings.drop -%}
<section class="section section--dark">
  <div class="page-width">
    {%- if drop != blank -%}
      {%- liquid
        assign release_ts = drop.release_date.value | date: '%s' | plus: 0
        assign now_ts = 'now' | date: '%s' | plus: 0
        assign drop_coll = drop.collection.value
      -%}
      <div class="drop-feature">
        <a href="{{ drop.system.url }}" class="drop-feature__media">
          {%- if drop.image != blank -%}
            {{ drop.image.value | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 1000, 1600', sizes: '(min-width: 990px) 56vw, 100vw', alt: drop.name.value }}
          {%- endif -%}
        </a>
        <div>
          <p class="eyebrow">{% if release_ts > now_ts %}{{ 'drops.upcoming' | t }}{% else %}{{ 'drops.latest' | t }}{% endif %}</p>
          <h2>{{ drop.name.value }}</h2>
          {%- if drop.brands != blank -%}<p class="drop-feature__brands">{{ drop.brands.value | join: ' / ' | upcase }}</p>{%- endif -%}
          <p class="drop-feature__date">
            {{ 'drops.landing' | t }}: <strong>{{ drop.release_date.value | date: '%-d %B' }}</strong>
            {%- if drop_coll != blank %} · {{ 'drops.product_count' | t: count: drop_coll.products_count }}{% endif -%}
          </p>
          {%- if release_ts > now_ts -%}
            {% render 'countdown', target: drop.release_date.value %}
          {%- endif -%}
          <a href="{{ drop.system.url }}" class="button button--accent">{{ 'drops.view' | t }}</a>
        </div>
      </div>
    {%- else -%}
      <div class="drop-feature">
        <div class="drop-feature__media"></div>
        <div>
          <p class="eyebrow">{{ 'drops.upcoming' | t }}</p>
          <h2>Japan Drop #004</h2>
          <p class="drop-feature__brands">INNO64 / POP RACE / AOSHIMA</p>
          <p class="drop-feature__date">{{ 'drops.landing' | t }}: <strong>18 October</strong></p>
          <a href="/pages/drops" class="button button--accent">{{ 'drops.view' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured drop",
  "settings": [
    { "type": "metaobject", "id": "drop", "label": "Drop", "metaobject_type": "drop" }
  ],
  "presets": [{ "name": "Featured drop" }]
}
{% endschema %}
