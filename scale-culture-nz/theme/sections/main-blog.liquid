{%- comment -%} Journal index with category filters (SOP §33) {%- endcomment -%}
<div class="collection-hero">
  <div class="page-width">
    <p class="eyebrow">{{ 'journal.eyebrow' | t }}</p>
    <h1>{{ blog.title }}</h1>
    {%- if blog.all_tags.size > 0 -%}
      <nav class="tag-nav" aria-label="{{ 'journal.categories' | t }}">
        <a href="{{ blog.url }}"{% unless current_tags %} aria-current="page"{% endunless %}>{{ 'garage.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handleize }}"{% if current_tags contains tag %} aria-current="page"{% endif %}>{{ tag }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>
{%- paginate blog.articles by 12 -%}
  <section class="section">
    <div class="page-width">
      <ul class="article-grid">
        {%- for article in blog.articles -%}
          <li{% if forloop.first and current_page == 1 and current_tags == blank %} class="article-grid__feature"{% endif %}>{% render 'article-card', article: article %}</li>
        {%- else -%}
          <li class="empty-state">{{ 'journal.empty' | t }}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    </div>
  </section>
{%- endpaginate -%}
{% schema %}
{ "name": "Journal", "settings": [] }
{% endschema %}
