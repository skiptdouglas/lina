<section class="hero">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>
  <div class="page-width hero__content">
    <span class="hero__stripe" aria-hidden="true"></span>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:#cfd0d2;margin-bottom:12px">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--accent">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link }}" class="button button--outline">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Large automotive/model photograph, 2400px wide minimum." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Japan Drop #004 — Out now" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight from Japan" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Limited-run die-cast, model kits and automotive collectibles for serious collectors." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop new drops" },
    { "type": "url", "id": "button_link", "label": "Primary link", "default": "/collections/new-arrivals" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "View pre-orders" },
    { "type": "url", "id": "button2_link", "label": "Secondary link", "default": "/collections/pre-orders" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
