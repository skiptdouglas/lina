{%- comment -%}
  Product page (SOP §14). Left: gallery. Right: brand, name, scale, price, stock,
  quantity, add to cart / reserve, wishlist. Below: description, specs, shipping,
  pre-order info. Sticky mobile add-to-cart (SOP §31).
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.scale
  assign variant = product.selected_or_first_available_variant
  capture state
    render 'stock-state', product: product, variant: variant
  endcapture
  assign state = state | strip
  assign can_buy = false
  if state == 'in_stock' or state == 'low_stock' or state == 'preorder'
    assign can_buy = true
  endif

  # Drop-day purchase limit (display + client-side guard; checkout Function enforces)
  capture lim
    render 'limit-state', product: product
  endcapture
  assign lim_parts = lim | strip | split: '|'
  assign lim_max = lim_parts[0] | plus: 0
  assign lim_remaining = lim_parts[1] | plus: 0
  assign lim_login = lim_parts[2]
  assign qty_max = ''
  if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    assign qty_max = variant.inventory_quantity
  endif
  if lim_max > 0
    if qty_max == ''
      assign qty_max = lim_remaining
    elsif lim_remaining < qty_max
      assign qty_max = lim_remaining
    endif
  endif
  assign show_sticky = can_buy
  if lim_login == 'true'
    assign show_sticky = false
  elsif lim_max > 0 and lim_remaining == 0
    assign show_sticky = false
  endif
-%}
<div class="page-width">
  <div class="product" data-product="{{ product.handle }}">
    <ul class="product__gallery" aria-label="{{ 'products.gallery' | t }}">
      {%- for media in product.media -%}
        <li>
          {%- liquid
            assign alt = media.alt | default: product.title
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
          -%}
          {{ media | image_url: width: 1600 | image_tag: loading: loading, widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 58vw, 100vw', alt: alt }}
        </li>
      {%- else -%}
        <li>{{ 'product-1' | placeholder_svg_tag }}</li>
      {%- endfor -%}
    </ul>

    <div class="product__info">
      <div class="product__info-inner">
        <a href="{{ product.vendor | url_for_vendor }}" class="product__brand">{{ product.vendor }}</a>
        <h1 class="product__title">{{ product.title }}</h1>
        {% render 'rating', product: product, full: true %}
        {%- if m.scale != blank -%}<span class="product__scale">{{ m.scale.value }}</span>{%- endif -%}
        <div class="product__price" data-price>{% render 'price', product: product, variant: variant %}</div>
        <div data-stock>{% render 'stock-status', product: product, variant: variant, state: state %}</div>

        {%- if state == 'preorder' -%}
          {% render 'preorder-info', product: product, variant: variant %}
        {%- endif -%}
        {%- if lim_max > 0 -%}
          {% render 'limit-badge', max: lim_max, remaining: lim_remaining, login_required: lim_login, full: true %}
        {%- endif -%}

        {%- form 'product', product, class: 'product__form', id: 'ProductForm', novalidate: 'novalidate' -%}
          {%- if product.has_only_default_variant -%}
            <input type="hidden" name="id" value="{{ variant.id }}">
          {%- else -%}
            <label for="VariantSelect" class="eyebrow">{{ product.options | join: ' / ' }}</label>
            <select id="VariantSelect" name="id" class="input" data-variant-select>
              {%- for v in product.variants -%}
                <option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                  {{ v.title }} — {{ v.price | money }}{% unless v.available %} ({{ 'products.stock.sold_out' | t }}){% endunless %}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}

          {%- if state == 'preorder' -%}
            {%- comment -%} Flags the line so cart/checkout/fulfilment can split pre-orders {%- endcomment -%}
            <input type="hidden" name="properties[_preorder]" value="true">
            {%- if m.preorder_nz_arrival != blank -%}
              <input type="hidden" name="properties[Expected NZ arrival]" value="{{ m.preorder_nz_arrival.value | escape }}">
            {%- endif -%}
          {%- endif -%}

          {%- if lim_max > 0 -%}
            <input type="hidden" data-limit-product="{{ product.id }}" data-limit-remaining="{{ lim_remaining }}" data-limit-max="{{ lim_max }}" data-limit-title="{{ product.title | escape }}">
          {%- endif -%}
          {%- if can_buy and lim_login == 'true' -%}
            <a href="{{ routes.account_login_url }}?checkout_url={{ product.url | url_encode }}" class="button button--full button--accent">{{ 'limits.login_to_buy' | t }}</a>
          {%- elsif can_buy and lim_max > 0 and lim_remaining == 0 -%}
            <button type="button" class="button button--full" disabled>{{ 'limits.reached' | t }}</button>
          {%- elsif can_buy -%}
            <div class="product__buy-row">
              <div class="qty">
                <button type="button" data-qty="-1" aria-label="{{ 'products.decrease' | t }}">−</button>
                <input type="number" name="quantity" value="1" min="1"{% if qty_max != '' %} max="{{ qty_max }}"{% endif %} aria-label="{{ 'products.quantity' | t }}">
                <button type="button" data-qty="1" aria-label="{{ 'products.increase' | t }}">+</button>
              </div>
              <button type="submit" name="add" class="button {% if state == 'preorder' %}button--accent{% endif %}" data-add-button>
                {%- if state == 'preorder' -%}{{ 'products.reserve' | t }}{%- else -%}{{ 'products.add_to_cart' | t }}{%- endif -%}
              </button>
            </div>
            {%- if state != 'preorder' and lim_max == 0 -%}{{ form | payment_button }}{%- endif -%}
          {%- else -%}
            {%- comment -%} Never show unavailable products as purchasable (SOP §15) {%- endcomment -%}
            <button type="button" class="button button--full" disabled>{% render 'stock-label', state: state %}</button>
            {%- if state != 'discontinued' -%}
              <p style="margin:0;font-size:.875rem">{{ 'products.notify_hint' | t }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- unless can_buy -%}
          {%- if state != 'discontinued' -%}{% render 'restock-form', product: product, variant: variant, state: state %}{%- endif -%}
        {%- endunless -%}

        <div class="product__collector">
          {% render 'wishlist-button', product: product, style: 'full' %}
          {% render 'wishlist-demand', product: product %}
        </div>
        {% render 'garage-buttons', product: product %}

        <div class="accordion">
          <details open>
            <summary>{{ 'products.description' | t }}</summary>
            <div class="rte">{{ product.description }}</div>
          </details>
          <details>
            <summary>{{ 'products.specifications' | t }}</summary>
            <div class="rte">{% render 'product-specs', product: product, variant: variant %}</div>
          </details>
          <details>
            <summary>{{ 'products.shipping' | t }}</summary>
            <div class="rte">{{ settings.shipping_info }}</div>
          </details>
          {%- if state == 'preorder' -%}
            <details>
              <summary>{{ 'preorder.how_it_works' | t }}</summary>
              <div class="rte">{{ settings.preorder_policy }}</div>
            </details>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if show_sticky -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="true">
    <div class="sticky-atc__info">
      <div class="sticky-atc__title">{{ product.title }}</div>
      <div>{{ variant.price | money }}{% if m.scale != blank %} · {{ m.scale.value }}{% endif %}</div>
    </div>
    <button type="submit" form="ProductForm" class="button button--accent" tabindex="-1">
      {%- if state == 'preorder' -%}{{ 'products.reserve' | t }}{%- else -%}{{ 'products.add_to_cart' | t }}{%- endif -%}
    </button>
  </div>
{%- endif -%}

<script type="application/json" data-recently-viewed-product>{{ product.handle | json }}</script>

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
