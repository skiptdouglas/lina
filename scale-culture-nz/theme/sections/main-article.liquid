{%- comment -%}
  Journal article (SOP §33). "Shop this story" lists the products linked in the
  article's `scale.products` metafield, so every guide links straight to stock.
{%- endcomment -%}
{%- assign linked = article.metafields.scale.products.value -%}
<article class="article">
  <header class="article__hero">
    {%- if article.image -%}
      {%- assign img_alt = article.image.alt | default: article.title -%}
      <div class="article__media">
        {{ article.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: img_alt }}
      </div>
    {%- endif -%}
    <div class="page-width article__head">
      {%- if article.tags.size > 0 -%}<p class="eyebrow">{{ article.tags | join: ' · ' }}</p>{%- endif -%}
      <h1>{{ article.title }}</h1>
      <p class="article__meta">{{ article.published_at | date: '%-d %B %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
    </div>
  </header>

  <div class="page-width article__layout">
    <div class="rte article__body">{{ article.content }}</div>
    {%- if linked != blank and linked.size > 0 -%}
      <aside class="article__shop" aria-labelledby="ShopThisStory">
        <h2 id="ShopThisStory">{{ 'journal.shop_story' | t }}</h2>
        <ul class="article__shop-list">
          {%- for p in linked limit: 12 -%}
            <li>{% render 'product-card', product: p %}</li>
          {%- endfor -%}
        </ul>
      </aside>
    {%- endif -%}
  </div>
</article>

{%- if section.settings.show_more -%}
  <section class="section section--grey">
    <div class="page-width">
      <div class="section-header"><h2>{{ 'journal.more' | t }}</h2><a href="{{ blog.url }}">{{ 'general.view_all' | t }}</a></div>
      <ul class="article-grid">
        {%- assign shown = 0 -%}
        {%- for a in blog.articles limit: 4 -%}
          {%- if a.id != article.id and shown < 3 -%}
            <li>{% render 'article-card', article: a %}</li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Person", "name": {{ article.author | json }} },
    "publisher": { "@type": "Organization", "name": {{ shop.name | json }} }
    {%- if article.image %}, "image": "https:{{ article.image | image_url: width: 1200 }}"{% endif %}
  }
</script>
{% schema %}
{
  "name": "Article",
  "settings": [{ "type": "checkbox", "id": "show_more", "label": "Show more articles", "default": true }]
}
{% endschema %}
