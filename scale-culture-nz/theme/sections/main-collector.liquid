{%- comment -%} Public collector profile — template for the `collector` metaobject (SOP §37) {%- endcomment -%}
{%- liquid
  assign c = metaobject
  assign stats = c.stats.value
  assign garage = c.garage.value
-%}
<section class="section section--dark">
  <div class="page-width garage-head">
    <div>
      <p class="eyebrow">{{ 'collector.eyebrow' | t }}</p>
      <h1>{{ c.display_name.value }}</h1>
      {%- if c.location != blank -%}<p class="eyebrow" style="color:#cfd0d2">{% render 'icon', name: 'pin' %} {{ c.location.value }}</p>{%- endif -%}
      {%- if c.bio != blank -%}<p style="max-width:560px;color:#cfd0d2">{{ c.bio.value }}</p>{%- endif -%}
    </div>
    {% render 'garage-stats', stats: stats %}
  </div>
</section>
<section class="section">
  <div class="page-width">
    {%- if garage.size > 0 -%}
      {% render 'garage-grid', entries: garage, editable: false %}
    {%- else -%}
      <p>{{ 'garage.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Collector profile", "settings": [] }
{% endschema %}
