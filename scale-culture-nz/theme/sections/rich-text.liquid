<section class="section{% if section.settings.style == 'dark' %} section--dark{% elsif section.settings.style == 'grey' %} section--grey{% endif %}">
  <div class="page-width" style="max-width:860px">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "style", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "grey", "label": "Grey" }, { "value": "dark", "label": "Dark" }], "default": "white" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
