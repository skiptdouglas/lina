<section class="section section--grey" style="padding:28px 0">
  <div class="page-width trust-row">
    <div>{% render 'icon', name: 'jp' %}<span>{{ section.settings.t1 }}</span></div>
    <div>{% render 'icon', name: 'truck' %}<span>{{ section.settings.t2 }}</span></div>
    <div>{% render 'icon', name: 'pin' %}<span>{{ section.settings.t3 }}</span></div>
    <div>{% render 'icon', name: 'shield' %}<span>{{ section.settings.t4 }}</span></div>
  </div>
</section>

{% schema %}
{
  "name": "Trust row",
  "settings": [
    { "type": "text", "id": "t1", "label": "Item 1", "default": "Imported direct from Japan" },
    { "type": "text", "id": "t2", "label": "Item 2", "default": "Tracked NZ-wide shipping" },
    { "type": "text", "id": "t3", "label": "Item 3", "default": "Auckland pickup available" },
    { "type": "text", "id": "t4", "label": "Item 4", "default": "Packed for collectors" }
  ],
  "presets": [{ "name": "Trust row" }]
}
{% endschema %}
