{%- comment -%}
  Collector profile editor (SOP §37): display name, public profile, interests
  that drive interest-based notifications and recommendations.
{%- endcomment -%}
{%- liquid
  assign makes = section.settings.makes | split: ','
  assign scales = section.settings.scales | split: ','
  assign brands = section.settings.brands | split: ','
  assign categories = section.settings.categories | split: ','
-%}
<section class="section">
  <div class="page-width" style="max-width:880px">
    <p class="eyebrow">{{ 'collector.eyebrow' | t }}</p>
    <h1>{{ 'collector.edit' | t }}</h1>
    {%- unless customer -%}
      <a href="{{ routes.account_login_url }}" class="button button--accent">{{ 'account.login' | t }}</a>
    {%- else -%}
      {%- assign p = customer.metafields.scale.profile.value -%}
      <form class="collector-form" data-profile-form>
        <div class="collector-form__grid">
          <label>{{ 'collector.display_name' | t }}
            <input class="input" name="display_name" maxlength="40" value="{{ p.display_name | default: customer.first_name | escape }}">
          </label>
          <label>{{ 'collector.location' | t }}
            <input class="input" name="location" maxlength="40" value="{{ p.location | escape }}" placeholder="Auckland">
          </label>
        </div>
        <label>{{ 'collector.bio' | t }}
          <textarea class="input" name="bio" maxlength="280" rows="3" placeholder="{{ 'collector.bio_placeholder' | t }}">{{ p.bio | escape }}</textarea>
        </label>

        {%- assign groups = 'makes,scales,brands,categories' | split: ',' -%}
        {%- for g in groups -%}
          {%- liquid
            case g
              when 'makes'
                assign options = makes
                assign chosen = p.interests.makes
              when 'scales'
                assign options = scales
                assign chosen = p.interests.scales
              when 'brands'
                assign options = brands
                assign chosen = p.interests.brands
              else
                assign options = categories
                assign chosen = p.interests.categories
            endcase
            assign chosen_str = chosen | join: '|' | prepend: '|' | append: '|'
          -%}
          <fieldset>
            <legend>
              {%- case g -%}
                {%- when 'makes' -%}{{ 'collector.interests_makes' | t }}
                {%- when 'scales' -%}{{ 'collector.interests_scales' | t }}
                {%- when 'brands' -%}{{ 'collector.interests_brands' | t }}
                {%- else -%}{{ 'collector.interests_categories' | t }}
              {%- endcase -%}
            </legend>
            <div class="chips chips--light">
              {%- for o in options -%}
                {%- assign v = o | strip -%}
                {%- assign needle = '|' | append: v | append: '|' -%}
                <label class="chip"><input type="checkbox" name="{{ g }}" value="{{ v | escape }}"{% if chosen_str contains needle %} checked{% endif %}><span>{{ v }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}

        <fieldset class="collector-form__toggles">
          <label><input type="checkbox" name="public"{% if p.public %} checked{% endif %}> {{ 'collector.public' | t }}</label>
          <label><input type="checkbox" name="show_wanted"{% if p.show_wanted != false %} checked{% endif %}> {{ 'collector.show_wanted' | t }}</label>
          <label><input type="checkbox" name="auto_garage"{% if p.auto_garage != false %} checked{% endif %}> {{ 'collector.auto_garage' | t }}</label>
        </fieldset>

        <div class="field-row">
          <button type="submit" class="button button--accent">{{ 'collector.save' | t }}</button>
          <a data-profile-public-link class="button button--outline"{% if p.public and p.slug != blank %} href="/pages/collector/{{ p.slug }}"{% else %} hidden{% endif %}>{{ 'collector.view_public' | t }}</a>
        </div>
        <p role="status" data-profile-status></p>
      </form>
    {%- endunless -%}
  </div>
</section>
{% schema %}
{
  "name": "Collector profile form",
  "settings": [
    { "type": "textarea", "id": "makes", "label": "Vehicle makes", "default": "Nissan, Toyota, Honda, Mazda, Mitsubishi, Subaru, Porsche, BMW, Mercedes-Benz, Ferrari, Lamborghini, McLaren, Audi, Volkswagen, Ford, Chevrolet" },
    { "type": "textarea", "id": "scales", "label": "Scales", "default": "1:64, 1:43, 1:24, 1:18" },
    { "type": "textarea", "id": "brands", "label": "Model brands", "default": "INNO64, MINI GT, Kaido House, Tarmac Works, POP RACE, Hobby Japan, Tomica Limited Vintage, Kyosho, Ignition Model, Aoshima, Fujimi, Hasegawa, Tamiya" },
    { "type": "textarea", "id": "categories", "label": "Categories", "default": "JDM, Motorsport, Plastic kits, Super GT, Group A, WRC, Le Mans, Liberty Walk, RWB, Rocket Bunny, Classics, Dioramas" }
  ]
}
{% endschema %}
