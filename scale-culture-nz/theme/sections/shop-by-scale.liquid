{%- comment -%} Shop by Scale (SOP §6). First block is featured (1:64 by default). {%- endcomment -%}
<section class="section">
  <div class="page-width">
    <div class="section-header">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    </div>
    <div class="scale-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.collection.url | default: '#' }}" class="scale-tile{% if forloop.first %} scale-tile--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- assign img = block.settings.image | default: block.settings.collection.image -%}
          {%- if img != blank -%}{{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 750px) 50vw, 100vw', alt: '' }}{%- endif -%}
          <span class="scale-tile__label">{{ block.settings.scale }}</span>
          <span class="scale-tile__sub">{{ block.settings.caption }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by scale",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find your size" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by scale" }
  ],
  "blocks": [
    {
      "type": "scale",
      "name": "Scale",
      "settings": [
        { "type": "text", "id": "scale", "label": "Scale", "default": "1:64" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "The collector's scale" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (falls back to collection image)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by scale",
      "blocks": [
        { "type": "scale", "settings": { "scale": "1:64", "caption": "The collector's scale — INNO64, MINI GT, Kaido House, POP RACE" } },
        { "type": "scale", "settings": { "scale": "1:43", "caption": "Motorsport & classics" } },
        { "type": "scale", "settings": { "scale": "1:24", "caption": "Die-cast & plastic kits" } },
        { "type": "scale", "settings": { "scale": "1:18", "caption": "Display pieces" } }
      ]
    }
  ]
}
{% endschema %}
