{%- comment -%} Latest journal articles for the homepage / product pages {%- endcomment -%}
{%- assign b = blogs[section.settings.blog] -%}
{%- if b.articles_count > 0 -%}
  <section class="section">
    <div class="page-width">
      <div class="section-header">
        <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
        <a href="{{ b.url }}">{{ 'general.view_all' | t }}</a>
      </div>
      <ul class="article-grid">
        {%- for a in b.articles limit: 3 -%}<li>{% render 'article-card', article: a %}</li>{%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Journal rail",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "default": "journal" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collector guides" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" }
  ],
  "presets": [{ "name": "Journal rail" }]
}
{% endschema %}
