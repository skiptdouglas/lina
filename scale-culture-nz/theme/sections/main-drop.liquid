{%- comment -%}
  Drop page — template for the `drop` metaobject (SOP §16).
  Name, release date, brands, product count, promo image, countdown, product grid.
  Drops stay published after release so the archive remains browsable.
{%- endcomment -%}
{%- liquid
  assign drop = metaobject
  assign coll = drop.collection.value
  assign release_ts = drop.release_date.value | date: '%s' | plus: 0
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign upcoming = false
  if release_ts > now_ts
    assign upcoming = true
  endif
-%}
<section class="section section--dark">
  <div class="page-width drop-feature">
    <div class="drop-feature__media">
      {%- if drop.image != blank -%}
        {{ drop.image.value | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 1000, 1400, 1800', sizes: '(min-width: 990px) 56vw, 100vw', alt: drop.name.value }}
      {%- endif -%}
    </div>
    <div>
      <p class="eyebrow">{% if upcoming %}{{ 'drops.upcoming' | t }}{% else %}{{ 'drops.released' | t }}{% endif %}</p>
      <h1>{{ drop.name.value }}</h1>
      {%- if drop.brands != blank -%}<p class="drop-feature__brands">{{ drop.brands.value | join: ' / ' | upcase }}</p>{%- endif -%}
      <p class="drop-feature__date">
        {{ 'drops.landing' | t }}: <strong>{{ drop.release_date.value | date: '%-d %B %Y' }}</strong>
        {%- if coll != blank %} · {{ 'drops.product_count' | t: count: coll.products_count }}{% endif -%}
      </p>
      {%- if upcoming -%}{% render 'countdown', target: drop.release_date.value %}{%- endif -%}
      {%- if drop.summary != blank -%}<div class="rte" style="color:#cfd0d2">{{ drop.summary | metafield_tag }}</div>{%- endif -%}
      {%- if upcoming -%}
        {%- if settings.klaviyo_public_key != blank -%}
          {% render 'drop-reminder', drop: drop %}
        {%- else -%}
          <a href="#drop-alerts" class="button button--accent">{{ 'drops.notify' | t }}</a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{%- if coll != blank -%}
  <section class="section">
    <div class="page-width">
      {%- if upcoming and section.settings.hide_until_release -%}
        <div class="empty-state"><h2>{{ 'drops.reveal' | t }}</h2></div>
      {%- else -%}
        <ul class="product-grid product-grid--4">
          {%- for product in coll.products limit: 100 -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Drop",
  "settings": [
    { "type": "checkbox", "id": "hide_until_release", "label": "Hide products until release", "default": false, "info": "Leave off to let pre-orders run before the drop lands." }
  ]
}
{% endschema %}
