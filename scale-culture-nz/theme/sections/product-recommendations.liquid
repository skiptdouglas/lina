{%- comment -%}
  Related models / Customers also bought (SOP §14). Uses Shopify's
  recommendations API — 'related' or 'complementary' intent (configure
  complementary products in the Search & Discovery app).
{%- endcomment -%}
<section class="section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
      <ul class="product-grid product-grid--4">
        {%- for product in recommendations.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Related models" },
    { "type": "select", "id": "intent", "label": "Type", "options": [{ "value": "related", "label": "Related models" }, { "value": "complementary", "label": "Customers also bought" }], "default": "related" }
  ]
}
{% endschema %}
