{%- comment -%} Recently viewed (SOP §14). Rendered client-side from localStorage via /products/<handle>?view=card. {%- endcomment -%}
<section class="section section--grey" data-recently-viewed hidden>
  <div class="page-width">
    <div class="section-header"><h2>{{ section.settings.heading }}</h2></div>
    <ul class="product-grid product-grid--4" data-recently-viewed-grid></ul>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" }]
}
{% endschema %}
