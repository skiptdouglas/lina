# Shopify app (Dev Dashboard → your app → Settings)
SHOPIFY_STORE=scaleculture.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10
# Public HTTPS URL of this service (app proxy target is $SERVICE_URL/proxy)
SERVICE_URL=https://collector.scaleculture.co.nz
# Optional: set directly instead of installing via /auth
SHOPIFY_ADMIN_TOKEN=
# Optional: Klaviyo private key (scopes: profiles:write) for interest sync
KLAVIYO_PRIVATE_KEY=
PORT=8787
DATA_DIR=.data
