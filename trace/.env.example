# TRACE configuration.
#
#   make init      # copies this file to .env and generates local secrets
#
# There are no default credentials. Compose refuses to start when a secret is
# missing (docs/SECURITY.md §2). Never commit .env.

# ---- runtime ---------------------------------------------------------------
TRACE_ENV=dev
TRACE_LOG_LEVEL=INFO
TRACE_API_PORT=8000
TRACE_UI_PORT=3000

# ---- authentication --------------------------------------------------------
# token  : bearer tokens from TRACE_API_TOKENS below (default)
# dev    : injects a full-privilege local principal; refused when TRACE_ENV is
#          staging or prod
TRACE_AUTH_MODE=token

# JSON object keyed by token. Generate real tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: ADMIN | LEAD_INVESTIGATOR | INVESTIGATOR | ANALYST | AUDITOR | VIEWER | SERVICE
TRACE_API_TOKENS={"replace-me":{"subject":"analyst@example.com","roles":["ADMIN"],"tenant":"default"}}

TRACE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- evidence storage (MinIO / S3) ----------------------------------------
TRACE_MINIO_ACCESS_KEY=
TRACE_MINIO_SECRET_KEY=
TRACE_EVIDENCE_BUCKET=trace-evidence
TRACE_MINIO_PORT=9000
TRACE_MINIO_CONSOLE_PORT=9001
# 5 GiB
TRACE_EVIDENCE_MAX_UPLOAD_BYTES=5368709120

# ---- normalization, search and timeline (docs/NORMALIZATION.md) ------------
# Parse automatically once evidence is stored and verified. Parsing always
# reads a fresh copy from object storage, never the upload stream.
TRACE_PARSE_ON_INGEST=true

# Bounds applied while reading attacker-influenced evidence. A 40GB single-line
# file must degrade into a reported limit, not an out-of-memory kill.
TRACE_PARSE_MAX_RECORDS=5000000
TRACE_PARSE_MAX_BYTES=8589934592
TRACE_PARSE_MAX_RECORD_BYTES=8388608
TRACE_RECORD_MAX_BYTES=4194304

# Event storage: clickhouse (production) | sql (development, small deployments)
TRACE_EVENT_STORE=clickhouse

# Search: sql (served from the event store) | opensearch (adds fuzzy + ranking)
TRACE_SEARCH_BACKEND=sql
TRACE_OPENSEARCH_INDEX=trace-events
TRACE_OPENSEARCH_USERNAME=
TRACE_OPENSEARCH_PASSWORD=

# ---- evidence anchoring (docs/ANCHORING.md) --------------------------------
# Evidence -> SHA-256 -> manifest -> Merkle leaf -> root -> signed -> ledger.
# Only the 32-byte root is ever published. Evidence never leaves TRACE.
TRACE_ANCHOR_ENABLED=true

# local           append-only local ledger; self-attested, works offline
# opentimestamps  Bitcoin via OpenTimestamps calendars; free, confirms in hours
# evm             an Ethereum-compatible chain; costs gas, confirms in minutes
# file            writes a signed receipt for an external notary / WORM store
TRACE_ANCHOR_BACKEND=local

# Publish the tree head automatically rather than on demand.
TRACE_ANCHOR_AUTO=false
TRACE_ANCHOR_INTERVAL_SECONDS=3600
TRACE_ANCHOR_MIN_NEW_LEAVES=1

# Ed25519 key that signs tree heads. Generated by `make init`.
#   python3 scripts/generate_signing_key.py --out deploy/keys/log-signing-key.pem
# Losing it does not invalidate past anchors; leaking it lets someone sign in
# your name. Treat it like a code-signing key.
TRACE_ANCHOR_SIGNING_KEY_PATH=/run/secrets/log-signing-key.pem
TRACE_ANCHOR_RECEIPT_DIR=/srv/trace/data/receipts

# Empty uses the public OpenTimestamps calendars.
TRACE_ANCHOR_OTS_CALENDARS=

# Only needed for TRACE_ANCHOR_BACKEND=evm.
TRACE_ANCHOR_EVM_RPC_URL=
TRACE_ANCHOR_EVM_PRIVATE_KEY=
TRACE_ANCHOR_EVM_CHAIN_ID=
TRACE_ANCHOR_EVM_CONFIRMATIONS=3

# ---- analytics (ClickHouse) ------------------------------------------------
TRACE_CLICKHOUSE_USER=trace
TRACE_CLICKHOUSE_PASSWORD=
TRACE_CLICKHOUSE_DATABASE=trace
TRACE_CLICKHOUSE_HTTP_PORT=8123

# ---- search / graph / model (used from Sprint 2 onwards) -------------------
TRACE_OPENSEARCH_PORT=9200
TRACE_OPENSEARCH_HEAP=1g
TRACE_MEMGRAPH_PORT=7687
TRACE_OLLAMA_PORT=11434

# ---- optional observability profile ---------------------------------------
TRACE_GRAFANA_PORT=3001
TRACE_GRAFANA_PASSWORD=
