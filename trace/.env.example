# TRACE configuration.
#
#   make init      # copies this file to .env and generates local secrets
#
# There are no default credentials. Compose refuses to start when a secret is
# missing (docs/SECURITY.md §2). Never commit .env.

# ---- runtime ---------------------------------------------------------------
TRACE_ENV=dev
TRACE_LOG_LEVEL=INFO
TRACE_API_PORT=8000
TRACE_UI_PORT=3000

# ---- authentication --------------------------------------------------------
# token  : bearer tokens from TRACE_API_TOKENS below (default)
# dev    : injects a full-privilege local principal; refused when TRACE_ENV is
#          staging or prod
TRACE_AUTH_MODE=token

# JSON object keyed by token. Generate real tokens with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Roles: ADMIN | LEAD_INVESTIGATOR | INVESTIGATOR | ANALYST | AUDITOR | VIEWER | SERVICE
TRACE_API_TOKENS={"replace-me":{"subject":"analyst@example.com","roles":["ADMIN"],"tenant":"default"}}

TRACE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- evidence storage (MinIO / S3) ----------------------------------------
TRACE_MINIO_ACCESS_KEY=
TRACE_MINIO_SECRET_KEY=
TRACE_EVIDENCE_BUCKET=trace-evidence
TRACE_MINIO_PORT=9000
TRACE_MINIO_CONSOLE_PORT=9001
# 5 GiB
TRACE_EVIDENCE_MAX_UPLOAD_BYTES=5368709120

# ---- analytics (ClickHouse) ------------------------------------------------
TRACE_CLICKHOUSE_USER=trace
TRACE_CLICKHOUSE_PASSWORD=
TRACE_CLICKHOUSE_DATABASE=trace
TRACE_CLICKHOUSE_HTTP_PORT=8123

# ---- search / graph / model (used from Sprint 2 onwards) -------------------
TRACE_OPENSEARCH_PORT=9200
TRACE_OPENSEARCH_HEAP=1g
TRACE_MEMGRAPH_PORT=7687
TRACE_OLLAMA_PORT=11434

# ---- optional observability profile ---------------------------------------
TRACE_GRAFANA_PORT=3001
TRACE_GRAFANA_PASSWORD=
