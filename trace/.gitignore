# Secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
*.tsbuildinfo
# The UI lockfile IS committed — reproducible container builds depend on it.
!package-lock.json

# Log signing keys. The private key obviously never belongs in git; the
# generated public key is per-deployment too, so publish it in your case
# reports and on a page you control, not here (docs/ANCHORING.md §5).
deploy/keys/
*.pem

# Local state
backend/data/
sample-data/case-demo-001/
*.db
*.sqlite3

# Editors / OS
.DS_Store
.idea/
.vscode/
